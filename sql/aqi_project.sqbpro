SELECT DISTINCT City FROM aqi_readings;
SELECT * FROM aqi_readings WHERE City = 'Delhi' LIMIT 10;
SELECT City, Date, AQI FROM aqi_readings 
WHERE AQI IS NOT NULL 
ORDER BY AQI DESC 
LIMIT 10;
SELECT City, AVG(AQI) AS avg_aqi 
FROM aqi_readings 
WHERE AQI IS NOT NULL 
GROUP BY City 
ORDER BY avg_aqi DESC;</sql><current_tab id="0"/></tab_sql></sqlb_project>
